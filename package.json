{
  "name": "entrenolab",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "node scripts/build-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false",
    "test:postgres": "node scripts/test-coownership-postgres.mjs",
    "test:e2e": "playwright test",
    "test:e2e:dev": "ng build --configuration development && playwright test --config=playwright.dev.config.ts",
    "test:e2e:prod": "ng build && playwright test --config=playwright.prod.config.ts",
    "test:e2e:pages": "node scripts/build-pages.mjs && playwright test --config=playwright.pages.config.ts",
    "test:e2e:supabase-real": "ng build && playwright test --config=playwright.supabase-real.config.ts",
    "lint": "node scripts/lint-check.mjs",
    "typecheck:e2e": "node scripts/typecheck-e2e.mjs",
    "format:check": "node scripts/format-check.mjs",
    "validate:migration": "node scripts/validate-migration.mjs",
    "validate:invite-email": "node scripts/validate-invite-email.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@supabase/supabase-js": "^2.112.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "jsdom": "^28.0.0",
    "libpg-query": "^17.7.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
